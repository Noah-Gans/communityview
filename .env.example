# Copy to .env.development for local `npm start`, or .env.production for `npm run deploy`.
# Only variables prefixed with REACT_APP_ are baked into the bundle at build time.

# Required for the map (local dev + GitHub Pages production build)
# REACT_APP_MAPBOX_ACCESS_TOKEN=pk.eyJ...

# Tour vicinity / nearby POIs (Google Places)
# REACT_APP_GOOGLE_MAPS_API_KEY=

# Regrid parcel API — server-side only (recommended; same pattern as Google Places):
# firebase functions:config:set regrid.token="YOUR_REGRID_JWT"
# firebase deploy --only functions:regridApi,functions:regridTileProxy
# Optional dev-only browser override (exposes token in bundle — not for production):
# REACT_APP_REGRID_API_TOKEN=

# Marketing: public sample property tour link (e.g. /tour/your-share-token)
# REACT_APP_SAMPLE_TOUR_PATH=/tour/your-token

# Marketing: scroll-scrub tour video at public/marketing/tour-scroll.mp4
# Re-export: ./scripts/marketing/export-tour-frames.sh (also re-encodes the MP4)

# Dev server bind address (see .env.development)
# HOST=127.0.0.1
# Default local dev: npm start → http://127.0.0.1:3000 (IPv4; avoids Firefox vs Chrome localhost mismatch)
# Stripe signup / card autofill: npm run start:https → https://localhost:3000 (accept self-signed cert once)

# Stripe is NOT configured via .env in this repo — publishable key is in src/components/auth/SignUp.js
# Firebase Functions Stripe secret: firebase functions:config:set stripe.secret="sk_..."
