rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Lightweight saved-map rows for fast dashboard listing
      match /mapIndex/{mapId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Maps collection
    match /maps/{mapId} {
      // Users can read/write their own maps
      allow read, write: if request.auth != null && 
                            request.auth.uid == resource.data.userId;
      
      // Allow creation (must set userId to current user)
      allow create: if request.auth != null && 
                      request.auth.uid == request.resource.data.userId;
      
      // Public read access for shared maps (for future sharing feature)
      allow read: if resource.data.isPublic == true;
    }
  }
}

